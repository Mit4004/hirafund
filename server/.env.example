# ==========================================
# HIRAFUND BACKEND - ENVIRONMENT VARIABLES
# ==========================================

# Server Port (Render sets PORT automatically; defaults to 5000 in dev)
PORT=5000
NODE_ENV=production

# MongoDB Atlas Connection String
# 1. Create a Cluster on MongoDB Atlas (https://www.mongodb.com/cloud/atlas)
# 2. Add a Database User and whitelist IPs (0.0.0.0/0 for Render access)
# 3. Replace below with your connection string:
#    Example: mongodb+srv://username:password@cluster0.xxxx.mongodb.net/hirafund?retryWrites=true&w=majority
MONGO_URI=mongodb+srv://your_username:your_password@cluster0.mongodb.net/hirafund?retryWrites=true&w=majority

# JWT Authentication Secret
# Use a strong, random secret string in production
JWT_SECRET=your_super_secret_jwt_key_here

# Client Frontend URL for CORS
# Enter your deployed Vercel frontend URL (or comma-separated URLs if multiple)
# Example: https://hirafund.vercel.app
CLIENT_URL=http://localhost:5173

# Admin Credentials for Seeding Database (npm run seed)
ADMIN_EMAIL=admin@hirafund.com
ADMIN_PASSWORD=admin
